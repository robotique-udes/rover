<launch>
  <arg name="urdf_file"   default="$(find-pkg-share rover_rviz)/urdf/arm_v2.urdf"/>
  <arg name="rviz_config" default="$(find-pkg-share rover_rviz)/rviz/arm.rviz"/>
  <arg name="use_gui"     default="false"/>

  <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
    <param name="robot_description" value="$(command 'cat $(var urdf_file)')"/>
  </node>

  <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" if="$(var use_gui)"/>
  <node pkg="joint_state_publisher"     exec="joint_state_publisher"     unless="$(var use_gui)"/>

  <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_config)"/>
</launch>