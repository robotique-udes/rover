// This assumes your workspace is built as such:
// ros2_ws
// └── src
//     └── rover
//         ├── rover_arm
//         ├── ...
{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/../../install/rover_msgs/**",
                "${workspaceFolder}/../../install/rover_joy/**",
                "${workspaceFolder}/../../install/rover_joy/**",
                "/opt/ros/**",
                "/usr/include/**"
            ],
            "defines": [
                "ROS=${env:ROS_DISTRO}"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c23",
            "cppStandard": "gnu++23",
            "intelliSenseMode": "linux-gcc-x64",
            "compileCommands": [
                "${workspaceFolder}/../../build/rover_joy/compile_commands.json",
                "${workspaceFolder}/../../build/rover_sim/compile_commands.json",
                "${workspaceFolder}/../../build/rover_arm/compile_commands.json",
                "${workspaceFolder}/../../build/rover_gui/compile_commands.json",
                "${workspaceFolder}/../../build/rover_drive_train/compile_commands.json",
                "${workspaceFolder}/../../build/rover_msgs/compile_commands.json",
                "${workspaceFolder}/../../build/rover_security/compile_commands.json",
                "${workspaceFolder}/../../build/rover_camera/compile_commands.json",
                "${workspaceFolder}/../../build/rover_can/compile_commands.json",
                "${workspaceFolder}/../../build/rover_auxiliary/compile_commands.json"
            ]
        }
    ],
    "version": 4
}