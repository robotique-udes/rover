  <property name="styleSheet">
   <string>
    /* Base styles for all controls */
    QComboBox, QLineEdit, QPushButton, QToolButton {
      border: 1px solid #777777;
      border-radius: 4px;
      padding: 0px 2px;
      min-height: 26px;
      max-height: 26px;
    }
    
    /* Video widget styling */
    QWidget#videoWidget {
      background-color: black;
      border-left: 1px solid #444444;
      border-right: 1px solid #444444;
    }
    
    /* Control buttons - consistent sizing and reduced padding for larger icons */
    QPushButton#arucoButton, QPushButton#toggleViewButton, 
    QPushButton#toggleControlsButton, QToolButton#screenshotButton, 
    QToolButton#recordButton, QPushButton#playPauseButton,
    QPushButton#cameraSettingsButton {
      min-width: 26px;
      max-width: 26px;
      min-height: 26px;
      max-height: 26px;
      border: 1px solid #777777;
      border-radius: 4px;
      padding: 0px;
    }
    
    /* Aruco IDs text box */
    QLineEdit#arucoIdsTextBox {
      min-width: 40px;
      max-width: 60px;
      color: #e0e0e0;
      background-color: transparent;
      border: 1px solid #777777;
    }
    
    /* Style for when IDs are detected */
    QLineEdit#arucoIdsTextBox[hasIds=&quot;true&quot;] {
      color: white;
      background-color: rgba(80, 150, 80, 0.3);
    }
    
    /* Status label styling */
    QLabel#statusLabel {
      color: white;
      background-color: rgba(0, 0, 0, 180);
      padding: 15px;
      border-radius: 5px;
      font-weight: bold;
      font-size: 16px;
    }
    
    /* Log text styling */
    QTextEdit#logDisplay {
      background-color: black;
      color: white; 
      font-family: monospace;
    }
    
    /* Stream header labels - hide them */
    QLabel.stream-header {
      max-height: 0px;
      padding: 0px;
      margin: 0px;
      border: none;
      font-size: 0px;
      color: transparent;
    }
   </string>
  </property>
